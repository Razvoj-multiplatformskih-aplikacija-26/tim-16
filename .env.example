# Razvojne vrednosti. Kopiraj u .env (koji se ne commit-uje) i po potrebi promeni.
POSTGRES_USER=svezko
POSTGRES_PASSWORD=svezko
POSTGRES_DB=svezko
POSTGRES_PORT=5436
SERVER_PORT=8080
# Za server pokrenut van Dockera (dart run apps/server/bin/server.dart).
DATABASE_URL=postgres://svezko:svezko@localhost:5436/svezko?sslmode=disable
NOVO_PRAVILO_NAJVISE_PO_STAVCI=
# Poreklo backoffice-a u pregledaču: flutter run -d chrome --web-port 8081
CORS_ORIGINS=http://localhost:8081
# Koliko minuta važi prijava. Za demonstraciju isteka stavi 1.
SESSION_TTL_MINUTES=480
COOKIE_SECURE=false
DEMO_PASSWORD=svezko-demo
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef